# Copy this file to ".env" and fill in your values. NEVER share or upload .env

# --- AI (get a key at console.groq.com -> API Keys; it starts with gsk_) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# --- First admin account (created the first time the app starts) ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Your station ---
STATION_NAME=Traffic Police, Hyderabad
DEFAULT_LOCATION=Hyderabad
# Official e-challan payment page, so owners are never sent to an unofficial site
PAYMENT_URL=
HELPLINE=

# --- WhatsApp: link (default, no setup) | twilio | meta ---
WHATSAPP_MODE=link
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
